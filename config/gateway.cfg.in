# Generated into the build directory by CMake (see CMakeLists.txt).
[DEFAULT]
ConnectionType=acceptor
SocketAcceptPort=5001
SocketReuseAddress=Y
BeginString=FIX.4.4
SenderCompID=GATEWAY
StartTime=00:00:00
EndTime=00:00:00
HeartBtInt=30
ResetOnLogon=Y
# Sequences reset on every logon, so a disk store would add writes without enabling recovery.
StoreType=memory
SocketNodelay=Y
UseDataDictionary=Y
DataDictionary=@FIX44_DICTIONARY@
FileStorePath=@CMAKE_BINARY_DIR@/fix_store
FileLogPath=@CMAKE_BINARY_DIR@/fix_log
[SESSION]
TargetCompID=CLIENT1
Role=CLIENT

